{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "target": "es6",
    "module": "esnext",
    "lib": ["dom", "es2017"],
    "types": ["node", "jest"],
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "rootDir": ".",
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    "eslint.config.mts",
    "jest.config.ts",
    "src",
    "src/browser.test.mjs",
    "src/index.test.mjs"
  ]
}
